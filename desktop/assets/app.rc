// Windows resources: icon, version info and manifest.
// Rebuild app.res after editing:  zig rc /fo app.res app.rc
#pragma code_page(65001)

1 ICON "icon.ico"
1 24 "app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,1,0
PRODUCTVERSION 1,0,1,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Jarif Hasan Akash"
      VALUE "FileDescription", "JHA Invoice Maker"
      VALUE "FileVersion", "1.0.1.0"
      VALUE "InternalName", "JHA Invoice Maker"
      VALUE "LegalCopyright", "Jarif Hasan Akash"
      VALUE "OriginalFilename", "JHA Invoice Maker.exe"
      VALUE "ProductName", "JHA Invoice Maker"
      VALUE "ProductVersion", "1.0.1.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
